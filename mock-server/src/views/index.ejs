<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopify Mock Server</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: #0a0a1a;
        color: #e0e0e0;
        font-family: system-ui, sans-serif;
      }
      .card {
        width: 100%;
        max-width: 40rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1.5rem;
        padding: 2.5rem;
      }
      h1 {
        margin: 0 0 1rem;
        font-size: 1.75rem;
      }
      .status {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        margin-bottom: 1.5rem;
      }
      .status.ok {
        background: #00a389;
        color: #fff;
      }
      .status.error {
        background: #ff5050;
        color: #fff;
      }
      .field {
        margin-bottom: 1.25rem;
      }
      .field-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(255, 255, 255, 0.45);
        margin-bottom: 0.375rem;
      }
      .field-value {
        font-family: ui-monospace, monospace;
        font-size: 0.8rem;
        color: #a0cfff;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.5rem;
        padding: 0.625rem 0.75rem;
        word-break: break-all;
      }
      button {
        cursor: pointer;
        border: 0;
        border-radius: 999px;
        padding: 0.625rem 1.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        background: #2d7ff9;
        color: #fff;
      }
      button:hover {
        background: #1a6fe0;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Shopify Mock Server</h1>

      <% if (token) { %>
      <span class="status ok">&#10003; Token loaded</span>
      <div class="field">
        <div class="field-label">Shop Domain</div>
        <div class="field-value"><%= shopDomain %></div>
      </div>
      <div class="field">
        <div class="field-label">Access Token</div>
        <div class="field-value"><%= token.access_token %></div>
      </div>
      <div class="field">
        <div class="field-label">Scope</div>
        <div class="field-value"><%= token.scope || '(none)' %></div>
      </div>
      <div class="field">
        <div class="field-label">Last Fetched</div>
        <div class="field-value">
          <%= new Date(token.fetched_at).toLocaleString() %>
        </div>
      </div>
      <% } else { %>
      <span class="status error">&#10007; No token</span>
      <p><%= error ?? 'No token fetched yet.' %></p>
      <% } %>

      <form method="POST" action="/refresh">
        <button type="submit">Refresh Token</button>
      </form>
    </div>
  </body>
</html>
